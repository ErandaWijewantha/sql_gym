# Copy this file to .env and adjust for your local MySQL install.

# Used ONLY once by scripts/bootstrap_local_mysql.sh to create the
# sql_gym database and the gym_user account below. Fill in your real
# local MySQL root password before running that script, then blank
# this back out -- it isn't needed again afterward.
MYSQL_ROOT_PASSWORD=

MYSQL_DATABASE=sql_gym
MYSQL_USER=gym_user
MYSQL_PASSWORD=gym_pw
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
